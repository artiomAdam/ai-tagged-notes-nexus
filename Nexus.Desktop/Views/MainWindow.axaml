<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
		xmlns:views="clr-namespace:Nexus.Desktop.Views"
		xmlns:models="clr-namespace:Nexus.Core.Models;assembly=Nexus.Core"
		xmlns:utils="clr-namespace:Nexus.Desktop.Utilities"
		xmlns:vmEnums="clr-namespace:Nexus.Desktop.ViewModels.Enums"
        x:Class="Nexus.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Knowledge Nexus"
        Width="1400" Height="700"
		MinWidth="1000" MinHeight="600"
		Background="#B0B0B0">
	<Window.Styles>
		<!-- TreeView items: pill-like rows -->
		<Style Selector="TreeViewItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="2,1"/>
			<Setter Property="MinHeight" Value="36"/>
			<Setter Property="Background" Value="#F5F5F8"/>
			<Setter Property="CornerRadius" Value="10"/>
		</Style>

		<Style Selector="TreeViewItem:pointerover">
			<Setter Property="Background" Value="#E3DBFF"/>
		</Style>

		<Style Selector="TreeViewItem:selected">
			<Setter Property="Background" Value="#4682B4"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<!-- Base style for note action buttons -->
		<Style Selector="Button.noteAction">
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Add (+) button -->
		<Style Selector="Button.noteAction.add">
			<Setter Property="Background" Value="#7A4FFF"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<!-- Delete (🗑) button -->
		<Style Selector="Button.noteAction.delete">
			<Setter Property="Background" Value="#00D74642"/>
			
			<Setter Property="FontSize" Value="18"/>
			
		</Style>
		<Style Selector="Button.noteAction.delete /template/ ContentPresenter">
			<Setter Property="Effect">
				<DropShadowEffect Color="Yellow"
								  BlurRadius="4"
								  Opacity="0.5"
								  OffsetX="0"
								  OffsetY="0"/>
			</Setter>
		</Style>
	
	
		<Style Selector="ListBox.similarNotes ListBoxItem">
			<Setter Property="Margin" Value="2,1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="MinHeight" Value="32"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="Background" Value="#F5F5F8"/>
		</Style>

		<Style Selector="ListBox.similarNotes ListBoxItem:pointerover">
			<Setter Property="Background" Value="#E3DBFF"/>
		</Style>

		<Style Selector="ListBox.similarNotes ListBoxItem:selected">
			<Setter Property="Background" Value="#4682B4"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
	</Window.Styles>


	<Window.Resources>
		<ResourceDictionary>
			<utils:TitleTrimConverter x:Key="TitleTrimConverter"/>
		</ResourceDictionary>
	</Window.Resources>
	
	
	<Grid ColumnDefinitions="Auto,*">
		<!-- LEFT PANEL -->
		<Border Grid.Column="0" Padding="8">
			<Border.Background>
				<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
					<GradientStop Color="#50c450c4" Offset="0.0" />
					<GradientStop Color="#00ff00ff" Offset="1.0" />
				</LinearGradientBrush>
			</Border.Background>

			<DockPanel Background="Transparent" LastChildFill="True">

				<!-- ========================= -->
				<!--       TOP TAB CONTROL     -->
				<!-- ========================= -->
				<TabControl DockPanel.Dock="Top"
							Margin="0,0,0,8"
							Height="160">

					<!-- ACTIONS TAB -->
					<TabItem Header="Actions">
						<StackPanel Orientation="Horizontal" Spacing="8" Margin="8">
							<Button Content="Add Note" Command="{Binding AddParentNoteCommand}" />
							<Button Content="Save" Command="{Binding SaveNoteCommand}"/>
						</StackPanel>
					</TabItem>

					<!-- SEARCH TAB -->
					<TabItem Header="Search">
						<StackPanel Margin="8" Spacing="6">
							
							<!-- Text + Go Buttons -->
							<StackPanel Spacing="15" Orientation="Horizontal">
								<TextBox Width="150" 
										 Watermark="Search..." 
										 Text="{Binding SearchText, Mode=TwoWay}" />
								<Button Width ="80" 
										Content="Go" 
										HorizontalContentAlignment="Center"
										FontSize="15"
										FontWeight="Bold"
										CornerRadius="5"
										FontFamily="Segoe UI Semibold"
										Command="{Binding SearchCommand}"
										VerticalContentAlignment="Center" />
							</StackPanel>

							<!-- Search modes + Clear Buttons -->
							<StackPanel Orientation ="Horizontal" Spacing="15">
								<ComboBox Width="150" SelectedIndex="{Binding SearchModeIndex}">
									<ComboBoxItem Content="Search by title"/>
									<ComboBoxItem Content="Search current note"/>
									<ComboBoxItem Content="Search in all notes"/>
								</ComboBox>
								<Button Width ="80"
										Content="Clear"
										HorizontalContentAlignment="Center"
										FontSize="15"
										FontWeight="Bold"
										CornerRadius="5"
										FontFamily="Segoe UI Semibold"
										Command="{Binding ClearSearchCommand}"
										VerticalContentAlignment="Center" />
							</StackPanel>
							
						</StackPanel>
					</TabItem>

					<!-- FILTER TAB -->
					<TabItem Header="Filter">
						<StackPanel Margin="4" Spacing="32" Orientation="Horizontal">

							<Border Background="#30000000" Padding="3,0,0,3" CornerRadius="5">
								<StackPanel Orientation="Vertical"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Spacing="2"
											Classes="ModeSegment">

									<RadioButton Content="Notes"
												 GroupName="ModeGroup"
												 IsChecked="{Binding IsHierarchyMode}"
												 Classes="ModeOption"
												 Width="80"/>

									<RadioButton Content="Topics"
												 GroupName="ModeGroup"
												 IsChecked="{Binding IsHierarchyMode, Converter={x:Static utils:BoolInvertConverter.Instance}}"
												 Classes="ModeOption"
												 Width="80"/>

								</StackPanel>
							</Border>

							<StackPanel Orientation="Vertical">
								<TextBlock Text="Filter Notes"
										   IsVisible="{Binding IsHierarchyMode}"
										   FontWeight="Bold"
										   FontStyle="Italic"
										   Margin="4,4,0,0"/>

								<TextBlock Text="Filter Topics"
										   IsVisible="{Binding IsHierarchyMode, Converter={x:Static utils:BoolInvertConverter.Instance}}"
										   FontWeight="Bold"
										   FontStyle="Italic"
										   Margin="4,4,0,0"/>
							
								<ComboBox MaxWidth="150"
										  IsVisible="{Binding IsHierarchyMode}"
										  SelectionChanged="FilterNotesChanged"
										  SelectedIndex="0">

									<ComboBoxItem Tag="{x:Static vmEnums:NotesFilterType.AtoZ}"    Content="A → Z"/>
									<ComboBoxItem Tag="{x:Static vmEnums:NotesFilterType.ZtoA}"    Content="Z → A"/>
									<ComboBoxItem Tag="{x:Static vmEnums:NotesFilterType.Newest}"  Content="Newest"/>
									<ComboBoxItem Tag="{x:Static vmEnums:NotesFilterType.Oldest}"  Content="Oldest"/>
									<!--<ComboBoxItem Tag="{x:Static vmEnums:NotesFilterType.Topic}"   Content="By Topic"/> -->

								</ComboBox>


								<ComboBox MaxWidth="150"
										  IsVisible="{Binding IsHierarchyMode, Converter={x:Static utils:BoolInvertConverter.Instance}}"
										  SelectionChanged="FilterTopicsChanged"
										  SelectedIndex="0">

									<ComboBoxItem Tag="{x:Static vmEnums:TopicsFilterType.AtoZ}"         Content="A → Z"/>
									<ComboBoxItem Tag="{x:Static vmEnums:TopicsFilterType.ZtoA}"         Content="Z → A"/>
									<!--<ComboBoxItem Tag="{x:Static vmEnums:TopicsFilterType.Similarity}"   Content="Similarity"/>-->

								</ComboBox>


							</StackPanel>
						</StackPanel>
					</TabItem>

				</TabControl>


				<!-- ========================= -->
				<!-- MAIN CONTENT AREA         -->
				<!-- ========================= -->

				<Grid RowDefinitions="*, Auto">

					<!-- ========================= -->
					<!-- UPPER TREE AREA (2/3)    -->
					<!-- ========================= -->
					<Grid Row="0">

						<TreeView x:Name="NotesTree"
								  ItemsSource="{Binding NotesHierarchy}"
								  SelectedItem="{Binding TreeSelection, Mode=TwoWay}"
								  IsVisible="{Binding IsHierarchyMode}">
							<TreeView.DataTemplates>
								<TreeDataTemplate DataType="models:Note" ItemsSource="{Binding Children}">
									<Grid ColumnDefinitions="2*,30,30"
										  Margin="4,0"
										  VerticalAlignment="Center">

										<TextBlock Grid.Column="0"
												   Margin="10,0,0,0"
												   VerticalAlignment="Center"
												   Text="{Binding Title, Converter={StaticResource TitleTrimConverter}}"
												   TextTrimming="CharacterEllipsis"
												   FontSize="14"/>

										<Button Grid.Column="1"
												
												Classes="noteAction add"
												HorizontalContentAlignment="Center"
												VerticalContentAlignment="Center"
												Content="＋"
												IsVisible="{Binding $parent[TreeViewItem].IsSelected}"
												Command="{Binding $parent[Window].DataContext.AddChildNoteCommand}"
												CommandParameter="{Binding}"/>

										<Button Grid.Column="2"
												
												Classes="noteAction delete"
												HorizontalContentAlignment="Center"
												VerticalContentAlignment="Center"
												Content="🗑"
												IsVisible="{Binding $parent[TreeViewItem].IsPointerOver}"
												Command="{Binding $parent[Window].DataContext.DeleteNoteCommand}"
												CommandParameter="{Binding}"/>
									</Grid>
								</TreeDataTemplate>



							</TreeView.DataTemplates>
						</TreeView>

						<!-- Topics mode -->
						<TreeView x:Name="TopicsTree"
								  ItemsSource="{Binding TopicsHierarchy}"
								  SelectedItem="{Binding TreeSelection, Mode=TwoWay}"
								  IsVisible="{Binding IsHierarchyMode, Converter={x:Static utils:BoolInvertConverter.Instance}}">
							<TreeView.Styles>
								<Style Selector="TreeViewItem">
									<Setter Property="Padding" Value="0"/>
									<Setter Property="Margin" Value="0"/>
								</Style>
							</TreeView.Styles>

							<TreeView.DataTemplates>

								<!-- Topic parent -->
								<TreeDataTemplate DataType="models:Topic" ItemsSource="{Binding Notes}">
									<DockPanel Margin="4" LastChildFill="True">

										<TextBlock Text="{Binding Name}"
												   FontWeight="Bold"
												   Margin="8,0"/>

										<!-- Remove topic button -->
										<Button Content="−"
												Width="22" Height="22"
												DockPanel.Dock="Right"
												IsVisible="{Binding $parent[TreeViewItem].IsPointerOver}"
												Command="{Binding $parent[Window].DataContext.RemoveTopicCommand}"
												CommandParameter="{Binding}"/>
									</DockPanel>
								</TreeDataTemplate>

								<!-- Note as child -->
								<TreeDataTemplate DataType="models:Note">
									<Grid ColumnDefinitions="2*,1*">
										<TextBlock Grid.Column="0"
												   Text="{Binding Title}"
												   VerticalAlignment="Center"
												   TextTrimming="CharacterEllipsis"
												   TextWrapping="NoWrap"
												   MaxWidth="150"/>
									</Grid>
								</TreeDataTemplate>

							</TreeView.DataTemplates>
						</TreeView>

					</Grid>


					<!-- ========================= -->
					<!-- SIMILAR NOTES AREA (1/3) -->
					<!-- ========================= -->
					<Border Grid.Row="1"
							Margin="0,12,0,0"
							Background="#22000000"
							Padding="6"
							CornerRadius="4">

						<StackPanel>
							<TextBlock Text="Similar Notes"
									   FontSize="14"
									   FontWeight="Bold"
									   Margin="0,0,0,6"/>

							<ListBox ItemsSource="{Binding SimilarNotes}"
									 SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
									 MaxHeight="150"
									 MinHeight="150"
									 Background="#00ffffff"
									 Classes="similarNotes">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Title}"
												   FontSize="14"/>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>

						</StackPanel>

					</Border>

				</Grid>

			</DockPanel>
		</Border>


		<!-- RIGHT SIDE: the whole editor area -->
		<views:NoteEditorView x:Name="NoteEditorHost"
							  Grid.Column="1" />
	</Grid>
</Window>






