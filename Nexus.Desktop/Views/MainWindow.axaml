<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
		xmlns:views="clr-namespace:Nexus.Desktop.Views"
		xmlns:models="clr-namespace:Nexus.Core.Models;assembly=Nexus.Core"
		xmlns:utils="clr-namespace:Nexus.Desktop.Utilities"
        x:Class="Nexus.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Knowledge Nexus"
        Width="900" Height="600">
	<Grid ColumnDefinitions="320,*">
		<!-- LEFT PANEL -->
		<Border Grid.Column="0" Background="#666" Padding="8">
			<DockPanel>
				<!-- Top Buttons -->
				<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
					<Button Content="Add Note" Command="{Binding AddParentNoteCommand}" />
					<Button Content="Add Child" Command="{Binding AddChildNoteCommand}" />
					<Button Content="Delete" Command="{CompiledBinding DeleteNoteCommand}"/>
					<Button Content="Save"   Command="{CompiledBinding SaveNoteCommand}"/>
				</StackPanel>

				<!-- Filters header + controls -->
				<StackPanel DockPanel.Dock="Top" Margin="0,8,0,8" Spacing="4">
					<Border Background="#3B66B1" Padding="6">
						<TextBlock Text="Filtering options" Foreground="White" />
					</Border>
					<!-- put real filter controls here -->
					<ToggleSwitch Content="Hierarchy mode"
								  IsChecked="{Binding IsHierarchyMode}"/>
				</StackPanel>

				<!-- Notes list: switch between hierarchy and topics list -->
				<Grid>
					<!-- Hierarchy mode -->
					<TreeView x:Name="NotesTree" ItemsSource="{Binding NotesHierarchy}"
						SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
							  IsVisible="{Binding IsHierarchyMode}">
						<TreeView.DataTemplates>
							<TreeDataTemplate DataType="models:Note" ItemsSource="{Binding Children}">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>

									<Button Content="＋"
											Width="20" Height="20" Padding="0" Margin="4,0,0,0"
											Command="{Binding $parent[Window].DataContext.AddChildNoteCommand}"
											CommandParameter="{Binding}">
										<Button.IsVisible>
											<MultiBinding Converter="{x:Static utils:EqualityToBoolConverter.Instance}">
												<Binding Path="$parent[TreeView].SelectedItem"/>
												<Binding Path="."/>
											</MultiBinding>
										</Button.IsVisible>
									</Button>
								</StackPanel>
							</TreeDataTemplate>
						</TreeView.DataTemplates>
					</TreeView>

					<!-- Topics mode  -->
					<TreeView x:Name="TopicsTree" ItemsSource="{Binding TopicsHierarchy}"
								SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
								IsVisible="{Binding IsHierarchyMode, 
											Converter={x:Static utils:BoolInvertConverter.Instance}}">
						<TreeView.DataTemplates>
							<TreeDataTemplate DataType="models:Topic"
											ItemsSource="{Binding Notes}">
								<TextBlock Text="{Binding Name}" FontWeight="Bold"/>
							</TreeDataTemplate>
						</TreeView.DataTemplates>
					</TreeView>
				</Grid>
			</DockPanel>
		</Border>

		<!-- RIGHT SIDE: the whole editor area -->
		<views:NoteEditorView Grid.Column="1"
							  DataContext="{Binding NoteEditor}" />
	</Grid>
</Window>






